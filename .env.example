ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your-password-here
ACTUAL_BUDGET_ID=your-budget-sync-id
# Optional: only needed if your budget is encrypted
ACTUAL_ENCRYPTION_PASSWORD=
# Optional: directory for Actual's local cache (default: /tmp/actual-budget-mcp-data)
# On most systems /tmp is cleared on reboot, so the budget is re-downloaded after each one.
# Point this somewhere permanent to avoid that.
ACTUAL_DATA_DIR=
