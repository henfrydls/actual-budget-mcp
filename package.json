{
  "name": "actual-budget-mcp",
  "version": "0.11.0",
  "description": "MCP server for Actual Budget: ask where the money went and write back safely, with previews before deletes and duplicate checks",
  "mcpName": "io.github.henfrydls/actual-budget-mcp",
  "type": "module",
  "bin": {
    "actual-budget-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/henfrydls/actual-budget-mcp"
  },
  "homepage": "https://github.com/henfrydls/actual-budget-mcp#readme",
  "bugs": {
    "url": "https://github.com/henfrydls/actual-budget-mcp/issues"
  },
  "author": "DLSLabs",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test:connection": "node dist/test-connection.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "npm run build && echo 'Build complete. Fill in your .env file, then run: npm run test:connection'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "actual-budget",
    "finance",
    "budgeting",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@actual-app/api": "^26.10.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^17.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "hono": "^4.13.13",
    "@hono/node-server": "^1.19.17",
    "ip-address": "^10.7.3",
    "fast-uri": "^3.1.8",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0"
  }
}
